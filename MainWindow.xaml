<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Height="56" Width="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Icon="app.ico"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <!-- Modern Capsule Button Style -->
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#33333A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#444450"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediaCircleButton" TargetType="Button">
            <Setter Property="Background" Value="#25252A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circleBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circleBorder" Property="Background" Value="#3A3A44"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circleBorder" Property="Background" Value="#555562"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayCircleButton" TargetType="Button" BasedOn="{StaticResource MediaCircleButton}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="playBorder" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="playBorder" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="playBorder" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TikTok / NotchNook Nav Tab Button Style (Matches ⊞ Widgets and 📥 Tray in user photo) -->
        <Style x:Key="NavTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7E808F"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#222432"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#181924"/>
                                <Setter Property="Foreground" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub Gaming Tab Button Style -->
        <Style x:Key="SubTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6C6E7E"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="subBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="subBorder" Property="Background" Value="#252736"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Toggle Button Style -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888890"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#25252C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#DDDDDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Action Tab Icon Button Style (Settings, etc.) -->
        <Style x:Key="HeaderTabIconButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888890"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="iconBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="7" Width="24" Height="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="iconBorder" Property="Background" Value="#25252C"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="iconBorder" Property="Background" Value="#1E1E26"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Island Container Canvas (Magnetic Catch Area) -->
    <Grid x:Name="RootIslandContainer" 
          Background="#00000000"
          HorizontalAlignment="Stretch" 
          VerticalAlignment="Stretch" 
          Margin="0"
          MouseEnter="IslandBorder_MouseEnter"
          MouseLeave="IslandBorder_MouseLeave"
          PreviewMouseLeftButtonDown="IslandBorder_PreviewMouseLeftButtonDown"
          PreviewMouseMove="IslandBorder_PreviewMouseMove"
          PreviewMouseLeftButtonUp="IslandBorder_PreviewMouseLeftButtonUp"
          PreviewMouseRightButtonUp="IslandBorder_PreviewMouseRightButtonUp"
          PreviewMouseWheel="IslandBorder_PreviewMouseWheel"
          Cursor="Hand"
          AllowDrop="True"
          DragEnter="Island_DragEnter"
          DragOver="Island_DragOver"
          Drop="Island_Drop">
        <!-- Root Pill Border -->
        <Border x:Name="IslandBorder"
                Width="280" Height="36"
                CornerRadius="18"
                Background="#0C0D12"
                BorderThickness="1.2"
                ClipToBounds="True"
                AllowDrop="True"
                DragEnter="Island_DragEnter"
                DragOver="Island_DragOver"
                DragLeave="Island_DragLeave"
                Drop="Island_Drop">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#3AFFFFFF" Offset="0.0"/>
                    <GradientStop Color="#14FFFFFF" Offset="0.25"/>
                    <GradientStop Color="#08FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border.Effect>
                <DropShadowEffect x:Name="IslandShadow" Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <!-- Background Custom Anime / Image / GIF Canvas -->
                <Image x:Name="ImgIslandBackground" Stretch="UniformToFill" Opacity="0.25" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                       Visibility="Collapsed" IsHitTestVisible="False"/>

                <!-- ============================================== -->
                <!-- 0. MINI CIRCLE VIEW (Paused / Minimal State)   -->
                <!-- ============================================== -->
                <Grid x:Name="MiniCircleView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Anime Mascot in Mini Circle (if enabled) -->
                    <Border x:Name="BorderMascotMini" Width="26" Height="26" CornerRadius="13" 
                            Background="#1A1A24" BorderBrush="#38BDF8" BorderThickness="1.2"
                            Visibility="Collapsed" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="TxtMascotMiniEmoji" Text="🎧" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="ImgMascotMini" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Default Music Icon in Mini Circle -->
                    <Border x:Name="BorderMusicDotMini" Width="24" Height="24" CornerRadius="12" Background="#1C1C22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Clip>
                            <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/>
                        </Border.Clip>
                        <Grid>
                            <TextBlock x:Name="TxtDotIcon" Text="🎵" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="ImgDotCover" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.Clip>
                                    <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================== -->
                <!-- 1. COMPACT PILL VIEW (Direct Music Controls)   -->
                <!-- ============================================== -->
                <Grid x:Name="CompactView" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Mini Cover / App Icon + Mascot + Equalizer -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <!-- Anime Mascot Avatar (Compact Pill) -->
                        <Border x:Name="BorderMascotPill" Width="22" Height="22" CornerRadius="11" 
                                Background="#1A1A24" BorderBrush="#38BDF8" BorderThickness="1.2" 
                                Visibility="Collapsed" ClipToBounds="True" Margin="0,0,5,0"
                                VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="TransMascotBob" Y="0"/>
                            </Border.RenderTransform>
                            <Grid>
                                <TextBlock x:Name="TxtMascotPillEmoji" Text="🎧" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="ImgMascotPill" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Mini Album Thumbnail (Circular clipped) -->
                        <Border Width="20" Height="20" CornerRadius="10" Background="#1C1C22" Margin="0,0,5,0">
                            <Border.Clip>
                                <EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10"/>
                            </Border.Clip>
                            <Grid>
                                <TextBlock x:Name="TxtMiniIcon" Text="🎵" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="ImgMiniCover" Stretch="UniformToFill" Visibility="Collapsed">
                                    <Image.Clip>
                                        <EllipseGeometry Center="10,10" RadiusX="10" RadiusY="10"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- Equalizer Animation Bars -->
                        <StackPanel x:Name="EqPanel" Orientation="Horizontal" VerticalAlignment="Center" Height="12" Margin="0,0,4,0">
                            <Border x:Name="EqBar1" Width="2" Height="6" Background="#1DB954" CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom"/>
                            <Border x:Name="EqBar2" Width="2" Height="12" Background="#1DB954" CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom"/>
                            <Border x:Name="EqBar3" Width="2" Height="5" Background="#1DB954" CornerRadius="1" Margin="1,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Song Title (Short & Clean) -->
                    <TextBlock x:Name="TxtCompactTitle" Grid.Column="1" 
                               Text="Müzik Çalınmıyor" 
                               Foreground="#EEEEEE" 
                               FontSize="11" 
                               FontWeight="Medium" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left" 
                               TextTrimming="CharacterEllipsis" 
                               Margin="4,0,4,0"
                               MaxWidth="120"/>

                    <!-- Right: Direct Music Controls & Expand Arrow -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <!-- Stopwatch Mini Badge if running -->
                        <Border x:Name="MiniTimerBadge" Background="#1E1E26" CornerRadius="8" Padding="4,1" Visibility="Collapsed" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱ " FontSize="8.5" Foreground="#F59E0B"/>
                                <TextBlock x:Name="TxtMiniTimer" Text="00:00" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>

                        <!-- Minecraft AFK Mini Badge if running -->
                        <Border x:Name="MiniAfkBadge" Background="#064E3B" CornerRadius="8" Padding="4,1" Visibility="Collapsed" Margin="0,0,3,0"
                                ToolTip="Minecraft AFK Farmı Aktif (Alt+K)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚔️" FontSize="8.5" Margin="0,0,2,0"/>
                                <TextBlock x:Name="TxtMiniAfk" Text="AFK" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                            </StackPanel>
                        </Border>

                        <!-- Crosshair Mini Badge if running -->
                        <Border x:Name="MiniCrossBadge" Background="#064E3B" CornerRadius="8" Padding="4,1" Visibility="Collapsed" Margin="0,0,3,0"
                                ToolTip="Gamer Crosshair Aktif (Alt+X)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="8.5" Margin="0,0,2,0"/>
                                <TextBlock Text="ON" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                            </StackPanel>
                        </Border>

                        <!-- CS2 Bomb Mini Badge if bomb is planted -->
                        <Border x:Name="MiniBombBadge" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="5,1" Visibility="Collapsed" Margin="0,0,3,0"
                                ToolTip="CS2 Bomba &amp; Çözme Asistanı">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💣" FontSize="8.5" Margin="0,0,2,0"/>
                                <TextBlock x:Name="TxtMiniBombTimer" Text="40.0s" FontSize="9.5" FontWeight="Bold" Foreground="#FCA5A5" Margin="0,0,3,0"/>
                                <Border x:Name="BadgeMiniDefuse" Background="#064E3B" CornerRadius="4" Padding="3,0">
                                    <TextBlock x:Name="TxtMiniDefuseState" Text="KİTSİZ (30.0s)" FontSize="8" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Fast Music Skip Buttons directly on compact pill -->
                        <Button x:Name="BtnCompactPrev" Style="{StaticResource MediaCircleButton}" 
                                Width="22" Height="22" Content="⏮" FontSize="9.5" Padding="0" Margin="1,0" 
                                ToolTip="Önceki Şarkı" Click="BtnPrev_Click"/>
                        <Button x:Name="BtnCompactPlay" Style="{StaticResource PlayCircleButton}" 
                                Width="24" Height="24" Content="▶" FontSize="10.5" Padding="0" Margin="1,0" 
                                ToolTip="Oynat / Duraklat" Click="BtnPlayPause_Click"/>
                        <Button x:Name="BtnCompactNext" Style="{StaticResource MediaCircleButton}" 
                                Width="22" Height="22" Content="⏭" FontSize="9.5" Padding="0" Margin="1,0" 
                                ToolTip="Sonraki Şarkı" Click="BtnNext_Click"/>
                        <Button x:Name="BtnCompactExpand" Style="{StaticResource IslandButton}"
                                Content="▼" FontSize="8" Padding="3,2" Background="Transparent" Foreground="#666675"
                                ToolTip="Genişlet (Alt+D)" Click="BtnCompactExpand_Click" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ============================================== -->
                <!-- 2. EXPANDED VIEW (Interactive Island)          -->
                <!-- ============================================== -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="8,4,8,6">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Apple Capsule Indicator Handle Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Header: App Source Badge, Tabs, Actions -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Tab Contents Area -->
                        <RowDefinition Height="*"/>
                        <!-- Row 3: Bottom Footer -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Apple Capsule Indicator Handle Bar (Just like iPhone Dynamic Island) -->
                    <Border x:Name="AppleIndicatorBar" Grid.Row="0" Width="70" Height="3.5" CornerRadius="1.75" 
                            Background="#35FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,5"
                            Cursor="Hand" ToolTip="Dinamik Ada (Sürükle veya Çift Tıkla: Küçült)"
                            MouseLeftButtonDown="AppleIndicatorBar_MouseLeftButtonDown">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                        </Border.Effect>
                    </Border>

                    <!-- Row 1: Header with NotchNook Tabs and Settings Actions (Matches user photo!) -->
                    <Grid Grid.Row="1" Margin="2,0,2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Minimal Clean Category Tabs (⊞ Widgets, 📥 Tray, 🚀 Shortcuts, 💻 System, 🎮 Gaming) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="TabMedia" Style="{StaticResource NavTabButton}" Content="⊞ Widgetler" GroupName="MainTabs" IsChecked="True" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabFileShelf" Style="{StaticResource NavTabButton}" Content="📥 Tepsi" GroupName="MainTabs" Margin="2,0,0,0" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabQuickApps" Style="{StaticResource NavTabButton}" Content="🚀 Kısayol" GroupName="MainTabs" Margin="2,0,0,0" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabSystemStats" Style="{StaticResource NavTabButton}" Content="💻 Sistem" GroupName="MainTabs" Margin="2,0,0,0" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabGamingTools" Style="{StaticResource NavTabButton}" Content="🎮 Araçlar" GroupName="MainTabs" Margin="2,0,0,0" Checked="Tab_Checked"/>
                        </StackPanel>

                        <!-- Right: Action Icons (Settings ⚙️, Pin 📌, Collapse ▲) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="TabSettings" Style="{StaticResource HeaderTabIconButton}" 
                                         Content="⚙️" FontSize="11" GroupName="MainTabs"
                                         ToolTip="Ayarlar" Checked="Tab_Checked" Margin="0,0,2,0"/>
                            <Button x:Name="BtnPin" Content="📌" Width="22" Height="22" FontSize="9.5"
                                    Background="Transparent" Foreground="#787886" Cursor="Hand" BorderThickness="0"
                                    ToolTip="Pencereyi açık tut (Pin)" Click="BtnPin_Click" Margin="0,0,2,0"/>
                            <Button x:Name="BtnCollapse" Content="▲" Width="22" Height="22" FontSize="9.5"
                                    Background="Transparent" Foreground="#787886" Cursor="Hand" BorderThickness="0"
                                    ToolTip="Küçült" Click="BtnCollapse_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: The Notch Inner Card (Deep Matte Black Squircle Container) -->
                    <Border x:Name="InnerWidgetCard" Grid.Row="2" 
                            Background="#060709" 
                            BorderBrush="#181920" 
                            BorderThickness="1" 
                            CornerRadius="16" 
                            Padding="8,6" 
                            Margin="0,0,0,2">
                        <Grid>
                            <!-- WIDGET 1: MEDIA PLAYER (MATCHES SCREENSHOT 1:1!) -->
                            <Grid x:Name="PanelMedia" Visibility="Visible">
                                <!-- Floating Top-Right App Badge (e.g. Spotify green circle with waves) -->
                                <Border x:Name="BadgeMediaSource" Width="24" Height="24" CornerRadius="12" 
                                        Background="#1DB954" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Margin="0,2,4,0" ToolTip="Aktif Müzik Kaynağı">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.4" ShadowDepth="1" Color="#1DB954"/>
                                    </Border.Effect>
                                    <Grid>
                                        <TextBlock x:Name="TxtExpandedAppIcon" Text="🟢" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtExpandedAppName" Text="Spotify" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <!-- Centered Media Content -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,2">
                                    <!-- Mini Album Cover Squircle -->
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#14151C" 
                                            ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,4" 
                                            BorderBrush="#22232E" BorderThickness="1">
                                        <Grid>
                                            <TextBlock x:Name="TxtLargeCoverPlaceholder" Text="🎵" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="ImgLargeCover" Stretch="UniformToFill" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <!-- Centered Song Title (Matches "Error" in user screenshot) -->
                                    <TextBlock x:Name="TxtExpandedTitle" Text="Müzik Çalınmıyor" 
                                               Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" 
                                               HorizontalAlignment="Center" TextAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" MaxWidth="260"/>

                                    <!-- Centered Artist / Status (Matches "Paused" in user screenshot) -->
                                    <TextBlock x:Name="TxtExpandedArtist" Text="Spotify veya Tarayıcı Başlatın" 
                                               Foreground="#787886" FontSize="10.5" 
                                               HorizontalAlignment="Center" TextAlignment="Center" 
                                               Margin="0,1,0,4" TextTrimming="CharacterEllipsis" MaxWidth="260"/>

                                    <!-- Progress Bar with Start & End Time -->
                                    <Grid Width="260" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtMediaPos" Grid.Column="0" Text="0:00" FontSize="8.5" Foreground="#5E5E6C" VerticalAlignment="Center" HorizontalAlignment="Left"/>
