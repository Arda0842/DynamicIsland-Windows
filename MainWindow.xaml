                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnPasteTranslate" Style="{StaticResource IslandButton}" 
                                            Content="📥 Yapıştır" Background="#181822" Foreground="#10B981"
                                            Padding="6,2.5" FontSize="9" Margin="2,0" ToolTip="Panodaki metni yapıştır ve çevir" Click="BtnPasteTranslate_Click"/>
                                    <Button x:Name="BtnClearTranslate" Style="{StaticResource IslandButton}" 
                                            Content="🧹" Background="#181822" Foreground="#888898"
                                            Padding="5,2.5" FontSize="9" Margin="2,0" ToolTip="Temizle" Click="BtnClearTranslate_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Giriş Kutusu + Çevir Butonu -->
                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbTranslateInput" Grid.Column="0" 
                                         Background="#14141C" Foreground="#FFFFFF" 
                                         BorderBrush="#252534" BorderThickness="1" 
                                         Padding="6,4" FontSize="10" 
                                         CaretBrush="#38BDF8"
                                         KeyDown="TbTranslateInput_KeyDown"/>
                                <Button x:Name="BtnDoTranslate" Grid.Column="1" Style="{StaticResource IslandButton}" 
                                        Content="🌐 Çevir" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"
                                        Padding="10,4" FontSize="9.5" Margin="4,0,0,0" Click="BtnDoTranslate_Click"/>
                            </Grid>

                            <!-- Row 2: Çeviri Sonucu -->
                            <Border Grid.Row="2" Background="#12121A" CornerRadius="8" BorderBrush="#1E1E2C" BorderThickness="1" Padding="8,4" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" MaxHeight="52">
                                        <TextBlock x:Name="TxtTranslateResult" Text="Çevrilecek metni yukarıya yazın veya yapıştırın..." 
                                                   Foreground="#38BDF8" FontSize="11" FontWeight="Medium" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <Button x:Name="BtnCopyResult" Style="{StaticResource IslandButton}" 
                                                Content="📋 Kopyala" Background="#1A1A26" Foreground="#FFFFFF"
                                                Padding="6,3" FontSize="8.5" Margin="0,0,0,2" ToolTip="Çeviriyi Panoya Kopyala" Click="BtnCopyResult_Click"/>
                                        <Button x:Name="BtnSpeakResult" Style="{StaticResource IslandButton}" 
                                                Content="🔊 Dinle" Background="#1A1A26" Foreground="#F59E0B"
                                                Padding="6,3" FontSize="8.5" ToolTip="Sesli Oku" Click="BtnSpeakResult_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 3: Hızlı Hazır Kalıplar (Gamer & Günlük) -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⚡ Hızlı:" Foreground="#666678" FontSize="8.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Content="İyi oyundu (GG)" Style="{StaticResource IslandButton}" Padding="4,1.5" FontSize="8" Margin="2,0" Background="#181822" Tag="İyi oyundu" Click="BtnQuickPhrase_Click"/>
                                <Button Content="Bana silah at" Style="{StaticResource IslandButton}" Padding="4,1.5" FontSize="8" Margin="2,0" Background="#181822" Tag="Bana silah at" Click="BtnQuickPhrase_Click"/>
                                <Button Content="Teşekkürler" Style="{StaticResource IslandButton}" Padding="4,1.5" FontSize="8" Margin="2,0" Background="#181822" Tag="Teşekkürler" Click="BtnQuickPhrase_Click"/>
                                <Button Content="Yardım et" Style="{StaticResource IslandButton}" Padding="4,1.5" FontSize="8" Margin="2,0" Background="#181822" Tag="Yardım et" Click="BtnQuickPhrase_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                        <!-- TAB 6: ⚙️ AYARLAR (SETTINGS) -->
                        <Grid x:Name="PanelSettings" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="2,0">
                                    <!-- Bölüm 1: Tema & Renk Seçimi -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎨 Renk &amp; Aura:" Foreground="#CCCCCC" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="🖤 OLED" Style="{StaticResource IslandButton}" Padding="3.5,1.5" FontSize="9" Margin="1,0" ToolTip="Apple OLED" Click="BtnTheme_Click" Tag="oled"/>
                                            <Button Content="🟢 Spotify" Style="{StaticResource IslandButton}" Padding="3.5,1.5" FontSize="9" Margin="1,0" ToolTip="Spotify Neon Yeşil" Click="BtnTheme_Click" Tag="spotify"/>
                                            <Button Content="🦁 Brave" Style="{StaticResource IslandButton}" Padding="3.5,1.5" FontSize="9" Margin="1,0" ToolTip="Brave Sunset" Click="BtnTheme_Click" Tag="brave"/>
                                            <Button Content="🟣 Cyber" Style="{StaticResource IslandButton}" Padding="3.5,1.5" FontSize="9" Margin="1,0" ToolTip="Cyberpunk Mor/Pembe" Click="BtnTheme_Click" Tag="cyberpunk"/>
                                            <Button Content="🌸 Sakura" Style="{StaticResource IslandButton}" Padding="3.5,1.5" FontSize="9" Margin="1,0" ToolTip="Anime Pembe Neon" Click="BtnTheme_Click" Tag="sakura"/>
                                            <Button Content="⚡ Edge" Style="{StaticResource IslandButton}" Padding="3.5,1.5" FontSize="9" Margin="1,0" ToolTip="Edgerunners Cyan &amp; Pink" Click="BtnTheme_Click" Tag="edgerunners"/>
                                            <Button Content="🌊 Buzul" Style="{StaticResource IslandButton}" Padding="3.5,1.5" FontSize="9" Margin="1,0" ToolTip="Buzul Cyan" Click="BtnTheme_Click" Tag="cyan"/>
                                            <Button Content="🌈 RGB" Style="{StaticResource IslandButton}" Padding="3.5,1.5" FontSize="9" Margin="1,0" ToolTip="Canlı RGB Chroma Animasyonu" Click="BtnTheme_Click" Tag="rgb"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bölüm 1.5: Anime Maskot & Canlı Fotoğraf/GIF Yükleyici -->
                                    <Border Background="#14141E" CornerRadius="8" Padding="6,4" Margin="0,0,0,6" BorderBrush="#252538" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="✨ Anime Maskotu &amp; Fotoğraf/GIF Teması" Foreground="#E2E8F0" FontSize="10" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtAnimeThemeStatus" Grid.Column="1" Text="Seçili: Yok" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Preset Maskotlar ve Dosya Seçici -->
                                            <Grid Margin="0,2,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="BtnMascotNeko" Content="🐱 Chibi Kedi" Style="{StaticResource IslandButton}" Padding="5,2" FontSize="9" Margin="0,0,3,0" Click="BtnMascotPreset_Click" Tag="neko"/>
                                                    <Button x:Name="BtnMascotLofi" Content="🎧 Lo-Fi Kız" Style="{StaticResource IslandButton}" Padding="5,2" FontSize="9" Margin="0,0,3,0" Click="BtnMascotPreset_Click" Tag="lofi"/>
                                                    <Button x:Name="BtnMascotCyber" Content="⚡ Cyberpunk" Style="{StaticResource IslandButton}" Padding="5,2" FontSize="9" Margin="0,0,3,0" Click="BtnMascotPreset_Click" Tag="cyber"/>
                                                    <Button x:Name="BtnClearMascot" Content="❌ Kaldır" Style="{StaticResource IslandButton}" Padding="4,2" FontSize="8.5" Background="#262635" Foreground="#94A3B8" Click="BtnClearMascot_Click" ToolTip="Maskotu ve özel resmi kapat"/>
                                                </StackPanel>
                                                <Button x:Name="BtnChooseCustomImage" Grid.Column="1" Style="{StaticResource IslandButton}" 
                                                        Content="📁 Resim / GIF Seç..." Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold"
                                                        Padding="7,2" FontSize="9" Click="BtnChooseCustomImage_Click" 
                                                        ToolTip="Bilgisayarından istediğin .gif, .png veya .jpg dosyasını yükle"/>
                                            </Grid>

                                            <!-- Görünüm Seçenekleri (Köşe Maskotu / Arka Plan) -->
                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <CheckBox x:Name="ChkShowMascot" Content="Köşe Maskotu" IsChecked="True" 
                                                          Foreground="#CBD5E1" FontSize="9" VerticalAlignment="Center" Margin="0,0,10,0" 
                                                          Click="ChkMascotOptions_Changed" ToolTip="Adanın sol köşesinde küçük anime karakteri göster"/>
                                                <CheckBox x:Name="ChkShowBgImage" Content="Arka Plan Olarak Yay" IsChecked="False" 
                                                          Foreground="#CBD5E1" FontSize="9" VerticalAlignment="Center" Margin="0,0,10,0" 
                                                          Click="ChkMascotOptions_Changed" ToolTip="Adanın arka planına hafif şeffaf yerleştir"/>
                                                <CheckBox x:Name="ChkMascotDance" Content="Müzikle Kafa Salla" IsChecked="True" 
                                                          Foreground="#CBD5E1" FontSize="9" VerticalAlignment="Center" 
                                                          Click="ChkMascotOptions_Changed" ToolTip="Müzik çalarken maskot ritim tutsun"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bölüm 2: Arka Plan Şeffaflığı -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🌫️ Şeffaflık:" Foreground="#CCCCCC" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Slider x:Name="SldOpacity" Grid.Column="1" Minimum="0.2" Maximum="1.0" Value="1.0" 
                                                TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" 
                                                ValueChanged="SldOpacity_ValueChanged"/>
                                        <TextBlock x:Name="TxtOpacityVal" Grid.Column="2" Text="100%" Foreground="#888898" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Bölüm 3: Kısayol Tuşları -->
                                    <Border Background="#14141A" CornerRadius="8" Padding="6,4" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="⌨️ Kısayol Tuşları (Değiştirip Kaydedebilirsiniz):" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="1,0">
                                                    <TextBlock Text="Ada:" Foreground="#888898" FontSize="9"/>
                                                    <TextBox x:Name="TbKeyToggle" Text="Alt+D" Background="#1C1C24" Foreground="#FFF" FontSize="9.5" Padding="2"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="1,0">
                                                    <TextBlock Text="Fare Işınla:" Foreground="#888898" FontSize="9"/>
                                                    <TextBox x:Name="TbKeyMouse" Text="Alt+M" Background="#1C1C24" Foreground="#FFF" FontSize="9.5" Padding="2"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="1,0">
                                                    <TextBlock Text="Sesli AI:" Foreground="#888898" FontSize="9"/>
                                                    <TextBox x:Name="TbKeyVoice" Text="Alt+V" Background="#1C1C24" Foreground="#FFF" FontSize="9.5" Padding="2"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="1,0">
                                                    <TextBlock Text="Müzik:" Foreground="#888898" FontSize="9"/>
                                                    <TextBox x:Name="TbKeyPlay" Text="Alt+P" Background="#1C1C24" Foreground="#FFF" FontSize="9.5" Padding="2"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Margin="1,0">
                                                    <TextBlock Text="MC Farm:" Foreground="#888898" FontSize="9"/>
                                                    <TextBox x:Name="TbKeyMcAfk" Text="Alt+K" Background="#1C1C24" Foreground="#FFF" FontSize="9.5" Padding="2"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="5" Margin="1,0">
                                                    <TextBlock Text="Crosshair:" Foreground="#888898" FontSize="9"/>
                                                    <TextBox x:Name="TbKeyCrosshair" Text="Alt+X" Background="#1C1C24" Foreground="#FFF" FontSize="9.5" Padding="2"/>
                                                </StackPanel>
                                                <Button Grid.Column="6" Style="{StaticResource IslandButton}" Content="Kaydet" 
                                                        Background="#10B981" Foreground="#FFF" FontSize="9.5" Padding="6,3" VerticalAlignment="Bottom" Margin="3,0,0,0"
                                                        Click="BtnSaveHotkeys_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bölüm 4: Dinamik Ada 6 Köşe / Kenar Konum Seçimi -->
                                    <Border Background="#14141A" CornerRadius="8" Padding="8,6" Margin="0,0,0,6" BorderBrush="#262635" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📍 Dinamik Ada Konumu (6 Nokta):" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtCurrentPosBadge" Grid.Column="1" Text="Üst Orta" Foreground="#A0A0B0" FontSize="9" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnPosTopLeft" Grid.Row="0" Grid.Column="0" Style="{StaticResource IslandButton}" Content="↖️ Sol Üst" Padding="6,4" FontSize="9.5" Margin="2" ToolTip="Ekranın sol üst köşesine sabitler" Click="BtnPosTopLeft_Click"/>
                                                <Button x:Name="BtnPosTopCenter" Grid.Row="0" Grid.Column="1" Style="{StaticResource IslandButton}" Content="⬆️ Üst Orta" Padding="6,4" FontSize="9.5" Margin="2" ToolTip="Ekranın üst ortasına sabitler (Varsayılan)" Click="BtnPosTopCenter_Click"/>
                                                <Button x:Name="BtnPosTopRight" Grid.Row="0" Grid.Column="2" Style="{StaticResource IslandButton}" Content="↗️ Sağ Üst" Padding="6,4" FontSize="9.5" Margin="2" ToolTip="Ekranın sağ üst köşesine sabitler" Click="BtnPosTopRight_Click"/>
                                                <Button x:Name="BtnPosBottomLeft" Grid.Row="1" Grid.Column="0" Style="{StaticResource IslandButton}" Content="↙️ Sol Alt" Padding="6,4" FontSize="9.5" Margin="2" ToolTip="Ekranın sol alt köşesine sabitler" Click="BtnPosBottomLeft_Click"/>
                                                <Button x:Name="BtnPosBottomCenter" Grid.Row="1" Grid.Column="1" Style="{StaticResource IslandButton}" Content="⬇️ Alt Orta" Padding="6,4" FontSize="9.5" Margin="2" ToolTip="Ekranın alt ortasına sabitler" Click="BtnPosBottomCenter_Click"/>
                                                <Button x:Name="BtnPosBottomRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource IslandButton}" Content="↘️ Sağ Alt" Padding="6,4" FontSize="9.5" Margin="2" ToolTip="Ekranın sağ alt köşesine sabitler" Click="BtnPosBottomRight_Click"/>
                                            </Grid>
                                            <TextBlock Text="💡 Adayı fare ile ekranda serbestçe de sürükleyebilirsiniz; bıraktığınız en yakın köşeye otomatik kilitlenir." Foreground="#777788" FontSize="8.5" Margin="1,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Bölüm 5: Gemini API Anahtarı & Tanıtım -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🤖 API:" Foreground="#CCCCCC" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <PasswordBox x:Name="PbApiKeySettings" Grid.Column="1" Background="#1C1C24" Foreground="#FFFFFF" 
                                                     BorderThickness="1" BorderBrush="#2C2C38" Padding="4,2" FontSize="9.5" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Style="{StaticResource IslandButton}" Content="Kaydet" 
                                                Background="#252530" FontSize="9" Padding="6,3" Margin="3,0" Click="BtnSaveApiKeySettings_Click"/>
                                        <Button Grid.Column="3" Style="{StaticResource IslandButton}" Content="❓ Tanıtımı Göster" 
                                                Background="#38BDF8" Foreground="#000" FontSize="9" Padding="6,3" Click="BtnShowIntro_Click"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- TAB 6: ONBOARDING / TANITIM (INTRO OVERLAY) -->
                        <Grid x:Name="PanelIntro" Visibility="Collapsed" Background="#0C0C0E">
                            <Border Background="#14141B" CornerRadius="10" Padding="10,8" BorderBrush="#38BDF8" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock Text="🏝️ Dinamik Ada'ya Hoş Geldiniz!" Foreground="#38BDF8" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Oyunlarda ve masaüstünde en pratik kısayol asistanınız!" Foreground="#888898" FontSize="9.5" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 4 Key Features -->
                                    <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,2">
                                        <Border Background="#1A1A24" CornerRadius="6" Padding="6,3" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="🎵 Spotify &amp; Brave" Foreground="#10B981" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="Şarkıları üstten anında kontrol edin, albüm kapağını görün." Foreground="#A0A0B0" FontSize="8.5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1A1A24" CornerRadius="6" Padding="6,3" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="🖱️ Alt + M (Işınlan)" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="Oyundayken fareyi aramak yok! İmleç doğrudan adaya ışınlanır." Foreground="#A0A0B0" FontSize="8.5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1A1A24" CornerRadius="6" Padding="6,3" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="🎙️ Alt + V (Sesli AI)" Foreground="#F59E0B" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="'Semicenk aç', 'Sesi kıs' deyin veya istediğiniz soruyu sorun." Foreground="#A0A0B0" FontSize="8.5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1A1A24" CornerRadius="6" Padding="6,3" Margin="2">
                                            <StackPanel>
                                                <TextBlock Text="⚙️ Şeffaflık &amp; RGB" Foreground="#E879F9" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="Ayarlardan arka plan şeffaflığını ve renkleri dilediğiniz gibi seçin." Foreground="#A0A0B0" FontSize="8.5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Bottom Ready Button -->
                                    <Button Grid.Row="2" Style="{StaticResource IslandButton}" 
                                            Content="Hadi Başlayalım! 🚀" Background="#38BDF8" Foreground="#000000" 
                                            FontWeight="Bold" Padding="12,4" HorizontalAlignment="Center" Margin="0,4,0,0"
                                            Click="BtnDismissIntro_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                    <!-- Row 3: Bottom Toolbar (Minimal & Clean) -->
                    <Grid Grid.Row="3" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Shortcuts Hint -->
                        <TextBlock Grid.Column="0" Text="Alt+D: Ada • Alt+M: Işınla • Alt+V: Sesli AI" 
                                   Foreground="#525463" FontSize="9" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Style="{StaticResource IslandButton}" 
                                Content="🎯 Ortaya Sıfırla" Padding="6,2" FontSize="8.5" 
                                Background="#161720" Foreground="#38BDF8" 
                                ToolTip="Ada Konumunu Ekranın Üst Ortasına Sıfırla" Click="BtnResetPosition_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
